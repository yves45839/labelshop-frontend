# =============================================================================
# Variables d'environnement — labelshop-frontend (Next.js)
# =============================================================================
# Copie ce fichier en `.env.local` et renseigne les valeurs réelles.
# Les variables préfixées NEXT_PUBLIC_ sont exposées au navigateur.
# Voir AMELIORATIONS.md (§1.2 et §1.4) pour le contexte.

# -----------------------------------------------------------------------------
# Backend API (Django sur PythonAnywhere en prod)
# -----------------------------------------------------------------------------
# URL de base du backend, sans slash final.
# Prod      : https://lr-samr.pythonanywhere.com
# Staging   : (à définir)
# Local dev : http://localhost:8000
NEXT_PUBLIC_API_URL=https://lr-samr.pythonanywhere.com

# -----------------------------------------------------------------------------
# Firebase Web SDK (clés publiques — pas des secrets, mais isolées par env)
# -----------------------------------------------------------------------------
# Récupérables dans la console Firebase :
# Project Settings → General → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
